{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "useUnknownInCatchVariables": false,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.js", "scripts/**/*.js"]
}
